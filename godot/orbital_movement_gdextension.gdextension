[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]

linux.debug.x86_64 = "res://../target/debug/liborbital_movement_gdextension_gd.so"
linux.release.x86_64 = "res://../target/release/liborbital_movement_gdextension_gd.so"
windows.debug.x86_64 = "res://../target/debug/orbital_movement_gdextension_gd.dll"
windows.release.x86_64 = "res://../target/release/orbital_movement_gdextension_gd.dll"
macos.debug = "res://../target/debug/liborbital_movement_gdextension_gd.dylib"
macos.release = "res://../target/release/liborbital_movement_gdextension_gd.dylib"
macos.debug.arm64 = "res://../target/debug/liborbital_movement_gdextension_gd.dylib"
macos.release.arm64 = "res://../target/release/liborbital_movement_gdextension_gd.dylib"
